VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Browser connects to this WebSocket backend (use wss:// in production).
VITE_COLLABORATION_URL=ws://localhost:1234
# Server only. NEVER prefix this secret with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
COLLAB_PORT=1234
COLLAB_HOST=127.0.0.1
COLLAB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
